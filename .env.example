# Set to 1 behind HTTPS in a hosted environment.
CLARO_SECURE=0
# Keep local runtime records outside source control.
CLARO_DB=.local/claro.sqlite
# Optional explicit public origin. Without it, the request origin must match the request host.
# CLARO_ORIGIN=https://your-service.onrender.com

# Optional server-only integrations. Disabled until explicit metered-use authorization.
CLARO_EXTERNAL_AI_ENABLED=0
TYPESAFE_API_KEY=
DEEPSEEK_API_KEY=
CLARO_PROVIDER_BUDGET_USD=0
CLARO_PROVIDER_MAX_REQUESTS=100
CLARO_PROVIDER_MAX_ATTEMPTS=2
CLARO_PROVIDER_TIMEOUT_SECONDS=6
# Keep this ledger on persistent storage to retain the cumulative budget across restarts.
# CLARO_PROVIDER_BUDGET_DB=/persistent/claro-provider-budget.sqlite
